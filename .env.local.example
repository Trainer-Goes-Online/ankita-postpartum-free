# ─────────────────────────────────────────────────────────────────────────────
# BodyWorx — Free international funnel (postpartum challenge).
# Copy this to `.env.local` and fill in the values. `.env.local` is
# gitignored — never commit real secrets. Replicate the same keys in
# Vercel Production env vars.
# ─────────────────────────────────────────────────────────────────────────────

# ── Deploy subdomain ────────────────────────────────────────────────────────
# Bare hostname (no protocol). Used by:
#  - middleware attribution capture
#  - Meta CAPI host allow-list (localhost + preview URLs auto-skip)
#  - `metadataBase` in app/layout.tsx (OG + canonical tags)
#  - fallback event_source_url for CAPI events
NEXT_PUBLIC_PRODUCTION_HOST=international.bodyworx.in

# ── Value stack label ───────────────────────────────────────────────────────
# The "worth X" line in the value stack + hero offer card. Swap per campaign
# region ($120 for UAE/US, ₹10,000 for India-facing, £90 for UK, etc.).
NEXT_PUBLIC_VALUE_STACK_LABEL=$120

# ── Pabbly Connect webhook ──────────────────────────────────────────────────
# NEW webhook URL — different from the India paid funnel's Pabbly.
PABBLY_WEBHOOK_URL=https://connect.pabbly.com/webhook-listener/webhook/IjU3NjIwNTZhMDYzMzA0MzA1MjZiNTUzNiI_3D_pc/IjU3NjcwNTY4MDYzNDA0M2Q1MjZkNTUzMjUxMzMi_pc    

# ── Meta Pixel + Conversions API ────────────────────────────────────────────
# DEDICATED pixel for the free funnel — separate dataset from the India
# paid funnel. NEXT_PUBLIC_META_PIXEL_ID is exposed to the browser for the
# base pixel. META_CAPI_ACCESS_TOKEN is server-only (never NEXT_PUBLIC_).
NEXT_PUBLIC_META_PIXEL_ID=2344458902754627
META_CAPI_ACCESS_TOKEN=EABeKxFGMYcQBSbotuBDhlItfp8KZCpGGJLA0CZBqrHb0VcQMZBoTzmQkgwf5a7TuYwEHdquN52yymOKsbqiYZAOLaHto2DdJExrNVMoANi1QF2ZB9S65jtpGeZBvz8I0h6rdilLch59kZCKhQGfw22BXQmxTgVitQnAqukEWUaauPyzRAc88L8k3XIk78UVawZDZD   

# ── GA4 + Microsoft Clarity ─────────────────────────────────────────────────
# Both host-gated inside app/layout.tsx — staging/preview traffic never
# lands in production analytics. Leave blank to disable.
NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-8T5B26LEVZ
NEXT_PUBLIC_CLARITY_PROJECT_ID=y9ylvwsrxa

# ── Webinar / batch content ─────────────────────────────────────────────────
# Update whenever the batch changes (~every 2 weeks).
# DATE — human-readable string shown across hero, sticky CTA, register strip,
# thank-you page (e.g. "8th September").
# TIMES — comma/dot-separated session times block, stated in the ad market's
# timezone (currently the UAE: "4:30 AM, 2:30 PM & 5:30 PM GST").
NEXT_PUBLIC_WEBINAR_DATE=8th September
NEXT_PUBLIC_WEBINAR_TIMES=4:30 AM, 2:30 PM & 5:30 PM GST

# ── WhatsApp community invite ───────────────────────────────────────────────
# International group invite. Rendered on /thank-you and in Pabbly follow-ups.
NEXT_PUBLIC_WHATSAPP_INVITE_URL=https://chat.whatsapp.com/CspCSL0F8h94jOiCAIXInd
